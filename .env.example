# Copy to .env.local (never committed) and change what you need.
# Every variable is checked at startup in src/env.ts.

# Local development: a SQLite file next to package.json.
DATABASE_URL=file:local.db

# Production (Turso): DATABASE_URL=libsql://<db-name>-<org>.turso.io and a token.
# DATABASE_AUTH_TOKEN=
