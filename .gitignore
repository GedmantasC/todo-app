node_modules/
.next/
next-env.d.ts
*.tsbuildinfo
coverage/

# Local databases: the schema and migrations are committed, the data never is
*.db
*.db-journal
*.db-wal
*.db-shm
playwright-report/
test-results/

# Local secrets and personal settings
.env
.env.*
!.env.example
.claude/settings.local.json

# OS and editor noise
.DS_Store
Thumbs.db
*.log
