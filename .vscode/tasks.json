{
  // Terminal > Run Task… (or Ctrl+Shift+B for the default build task)
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dev server",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Check everything (as CI does)",
      "type": "npm",
      "script": "check",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "Unit tests (watch)",
      "type": "npm",
      "script": "test:watch",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Browser tests",
      "type": "npm",
      "script": "test:e2e",
      "problemMatcher": []
    },
    {
      "label": "Apply database migrations",
      "type": "npm",
      "script": "db:migrate",
      "problemMatcher": []
    },
    {
      "label": "Open the database (Drizzle Studio)",
      "type": "npm",
      "script": "db:studio",
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
