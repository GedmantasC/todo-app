{
  // Shared with everyone who opens this folder.
  "editor.formatOnSave": true,

  // Hide generated files, so the explorer shows only what you edit.
  "files.exclude": {
    "**/node_modules": true,
    ".next": true,
    "next-env.d.ts": true,
    "**/*.tsbuildinfo": true
  },

  // Tuck config files under package.json in the explorer.
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "package.json": "package-lock.json, tsconfig.json, drizzle.config.ts",
    ".env.example": ".env, .env.local, *.db",
    "AGENTS.md": "CLAUDE.md"
  }
}
